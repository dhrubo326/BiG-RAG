### BiG-RAG Environment Configuration
### This is an example file - copy to .env and update values

###########################
### Server Configuration
###########################
HOST=0.0.0.0
PORT=8001
WEBUI_TITLE='BiG-RAG API'
WEBUI_DESCRIPTION='Bipartite Graph Retrieval-Augmented Generation with RL Training'

### CORS Configuration
# CORS_ORIGINS=http://localhost:3000,http://localhost:8080

### Optional SSL Configuration
# SSL=true
# SSL_CERTFILE=/path/to/cert.pem
# SSL_KEYFILE=/path/to/key.pem

### Logging Configuration
LOG_LEVEL=INFO
# LOG_DIR=/path/to/logs
# LOG_MAX_BYTES=10485760
# LOG_BACKUP_COUNT=5

#####################################
### API Authentication (Optional)
#####################################
# AUTH_ACCOUNTS='admin:admin123,user1:pass456'
# TOKEN_SECRET=your-secret-key-here
# TOKEN_EXPIRE_HOURS=48
# BIGRAG_API_KEY=your-secure-api-key-here

######################
### Dataset Settings
######################
### Default dataset to use if not specified in API requests
DEFAULT_DATASET=demo_test

### Directory Configuration
# INPUT_DIR=./datasets
# WORKING_DIR=./expr
# CORPUS_DIR=./datasets/{dataset}/raw
# PROCESSED_DIR=./datasets/{dataset}/processed

######################################################################################
### Query Configuration (Phase 3: Three-Path Retrieval + Semantic Reranking)
###
### BiG-RAG uses three retrieval paths:
###   Path A: Entity-based retrieval (top_k entities from entity index)
###   Path B: Relation-based retrieval (top_k relations from bipartite edge index)
###   Path C: Chunk-based retrieval (direct + indirect chunks)
###
### Total context = Path A results + Path B results + Path C results (10 items default)
######################################################################################

### Number of entities/relations retrieved from knowledge graph (Path A + Path B)
TOP_K=5

### Retrieval mode: hybrid (default), local (entities only), global (relations only), naive (chunks only)
RETRIEVAL_MODE=hybrid

### Enable semantic reranking (Phase 3.4)
### Uses cross-encoder to rerank chunk results for better precision (+10-20%)
### Default: false (requires sentence-transformers installation)
ENABLE_RERANKING=false

### Reranking Provider: local (default), jina, custom
RERANK_PROVIDER=local

### Local Reranking Models (requires sentence-transformers)
### Option 1: MS MARCO MiniLM (lightweight, fast, English only)
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

### Option 2: Jina Reranker v2 (multilingual, better quality)
# RERANK_MODEL=jinaai/jina-reranker-v2-base-multilingual

### Option 3: Custom local model path
# RERANK_MODEL=/path/to/your/custom/reranker/model

### Jina AI Reranker API (alternative to local reranking)
# RERANK_PROVIDER=jina
# JINA_API_KEY=your-jina-api-key-here
# JINA_RERANK_MODEL=jina-reranker-v2-base-multilingual
# JINA_API_URL=https://api.jina.ai/v1/rerank

### Custom Reranker API Endpoint
# RERANK_PROVIDER=custom
# CUSTOM_RERANK_API_URL=http://localhost:8080/rerank
# CUSTOM_RERANK_API_KEY=your-api-key-here

### Reranking Configuration
RERANK_BATCH_SIZE=32
RERANK_TOP_K=5

### Maximum context items to return
MAX_CONTEXT_ITEMS=10

### Enable LLM response caching
ENABLE_LLM_CACHE=true

########################################
### Document Processing Configuration
### (Phase 2.1: Metadata Preservation)
########################################

### Chunk size for document splitting (500-1500 recommended)
CHUNK_SIZE=1200
CHUNK_OVERLAP_SIZE=100

### Tiktoken model for tokenization
TIKTOKEN_MODEL=gpt-4o

### Entity types to extract (used in LLM prompts)
ENTITY_TYPES='["organization", "person", "geo", "time"]'

### Maximum async operations for entity extraction
MAX_ASYNC=4

### Enable LLM caching for entity extraction
ENABLE_LLM_CACHE_FOR_EXTRACT=true

########################################
### Embedding Configuration
### Choose: openai OR flagembedding
########################################

### Option 1: OpenAI Embeddings (Recommended for getting started)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=3072

### Option 2: FlagEmbedding (BAAI/bge-large-en-v1.5)
# EMBEDDING_PROVIDER=flagembedding
# EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
# EMBEDDING_DIM=1024
# EMBEDDING_DEVICE=cpu

### Embedding batch size
EMBEDDING_BATCH_SIZE=10
EMBEDDING_MAX_ASYNC=8

###########################################################
### LLM Configuration (for Entity Extraction)
### Supported providers: openai, anthropic, google, grok
###########################################################

### Default LLM Provider
LLM_PROVIDER=openai

### OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEMPERATURE=0.0
OPENAI_MAX_TOKENS=4096

### Anthropic (Claude) Configuration
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# ANTHROPIC_MAX_TOKENS=4096

### Google (Gemini) Configuration
# GOOGLE_API_KEY=your-google-api-key-here
# GOOGLE_MODEL=gemini-pro
# GOOGLE_MAX_TOKENS=4096

### xAI (Grok) Configuration
# XAI_API_KEY=your-xai-api-key-here
# GROK_MODEL=grok-beta
# GROK_MAX_TOKENS=4096

### LLM Request Timeout (seconds)
LLM_TIMEOUT=180

############################
### Storage Backend
### Phase 2.2: Multi-Backend Support
############################

### Default Storage (Recommended for small-scale deployment)
KV_STORAGE=JsonKVStorage
GRAPH_STORAGE=NetworkXStorage
VECTOR_STORAGE=NanoVectorDBStorage

### Production Storage Options

### Neo4j Graph Storage
# GRAPH_STORAGE=Neo4JStorage
# NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=your_password
# NEO4J_DATABASE=neo4j

### MongoDB Storage
# KV_STORAGE=MongoKVStorage
# GRAPH_STORAGE=MongoGraphStorage
# MONGO_URI=mongodb://root:root@localhost:27017/
# MONGO_DATABASE=BiGRAG

### Milvus Vector Storage
# VECTOR_STORAGE=MilvusVectorDBStorage
# MILVUS_URI=http://localhost:19530
# MILVUS_DB_NAME=bigrag

### ChromaDB Vector Storage
# VECTOR_STORAGE=ChromaDBStorage
# CHROMADB_HOST=localhost
# CHROMADB_PORT=8000

### FAISS Vector Storage (Recommended for large-scale)
# VECTOR_STORAGE=FaissVectorDBStorage
# FAISS_INDEX_TYPE=IVFFlat
# FAISS_NLIST=100

### Oracle Database Storage (Enterprise)
# KV_STORAGE=OracleKVStorage
# GRAPH_STORAGE=OracleGraphStorage
# VECTOR_STORAGE=OracleVectorStorage
# ORACLE_DSN=localhost:1521/XEPDB1
# ORACLE_USER=bigrag
# ORACLE_PASSWORD=your_password

### TiDB Storage
# KV_STORAGE=TiDBKVStorage
# VECTOR_STORAGE=TiDBVectorStorage
# TIDB_HOST=localhost
# TIDB_PORT=4000
# TIDB_USER=root
# TIDB_PASSWORD=your_password
# TIDB_DATABASE=bigrag

############################
### Document Registry
############################

### Document registry storage location
REGISTRY_PATH=./document_registry.json

### Max documents per dataset (0 = unlimited)
MAX_DOCUMENTS_PER_DATASET=0

### Auto-cleanup old jobs after N hours
JOB_CLEANUP_HOURS=24

############################
### Background Processing
############################

### Enable async document processing
ENABLE_ASYNC_PROCESSING=true

### Max concurrent document processing jobs
MAX_PARALLEL_JOBS=2

### Job queue size (0 = unlimited)
MAX_JOB_QUEUE_SIZE=100

### Job processing timeout (seconds)
JOB_TIMEOUT=600

########################################
### RL Training Configuration
### (Optional - Only for training)
########################################

### Training Mode (set to true when running RL training)
TRAINING_MODE=false

### Base Model Path
# BASE_MODEL=Qwen/Qwen2.5-3B-Instruct

### Training Algorithm: grpo, ppo, reinforce++
# RL_ALGORITHM=grpo

### Learning Rate
# ACTOR_LR=5e-7
# CRITIC_LR=1e-5

### Training Batch Size
# TRAIN_BATCH_SIZE=128

### Training Epochs
# TOTAL_EPOCHS=1

### GPU Configuration
# N_GPUS_PER_NODE=4
# TENSOR_MODEL_PARALLEL_SIZE=4
# GPU_MEMORY_UTILIZATION=0.5

### Tool Configuration (for RL training)
# TOOL_ENV=search
# MAX_TOOL_TURNS=5
# QUERY_START_TAG=<query>
# QUERY_END_TAG=</query>
# ANSWER_START_TAG=<answer>
# ANSWER_END_TAG=</answer>

### Weights & Biases Logging
# WANDB_PROJECT=BiG-RAG
# WANDB_ENTITY=your-wandb-username
# WANDB_API_KEY=your-wandb-api-key

### Ray Cluster Configuration
# RAY_ADDRESS=auto
# RAY_DASHBOARD_PORT=8265

########################################
### Evaluation Configuration
########################################

### Metrics to compute: em, f1, rouge_l, bleu, meteor
EVAL_METRICS=em,f1,rouge_l

### Evaluation batch size
EVAL_BATCH_SIZE=32

### Save evaluation results
SAVE_EVAL_RESULTS=true
EVAL_RESULTS_DIR=./evaluation_results

########################################
### Advanced Settings
########################################

### Enable debug mode (verbose logging)
DEBUG=false

### Profile performance (for optimization)
ENABLE_PROFILING=false

### Cache directory for model downloads
CACHE_DIR=./cache

### Tiktoken cache directory
TIKTOKEN_CACHE_DIR=./cache/tiktoken

### HuggingFace cache directory
HF_HOME=./cache/huggingface

### Retry configuration for API calls
API_RETRY_ATTEMPTS=3
API_RETRY_BACKOFF=1.0
API_RETRY_MAX_BACKOFF=10.0

### Rate limiting for API endpoints
ENABLE_RATE_LIMITING=false
RATE_LIMIT_PER_MINUTE=60

########################################
### Health Monitoring
########################################

### Enable health check endpoint
ENABLE_HEALTH_CHECK=true

### Health check interval (seconds)
HEALTH_CHECK_INTERVAL=60

### Prometheus metrics endpoint
ENABLE_METRICS=false
METRICS_PORT=9090

########################################
### Data Privacy & Security
########################################

### Enable data encryption at rest
ENABLE_ENCRYPTION=false
ENCRYPTION_KEY=your-encryption-key-here

### Enable audit logging
ENABLE_AUDIT_LOG=false
AUDIT_LOG_PATH=./logs/audit.log

### Data retention period (days, 0 = keep forever)
DATA_RETENTION_DAYS=0

### Enable PII detection and masking
ENABLE_PII_DETECTION=false
